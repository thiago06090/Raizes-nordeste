                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();\r",
                  "pm.environment.set(\"token\", response.accessToken);\r",
                  "pm.test(\"Status 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Token gerado\", () => {\r",
                  "    pm.expect(response.accessToken).to.not.be.empty;\r",
